@@ -83,6 +83,22 @@ def validate_module_identity(module_id: str, module_prefix: str | None):
             "identifier, so use [A-Za-z_][A-Za-z0-9_]* (at most 32 characters)")
 
 
+def module_constructor_ident(module_id: str) -> str:
+    """C identifier for this tree's registration function.
+
+    The MSVC constructor macro gives the .CRT$XCU entry external linkage and
+    `/include:`s it, because an unreferenced static entry is dropped in a
+    Release build (the module registry then comes up empty). External linkage
+    means the name has to be unique across every tree linked into one image;
+    the module id is already required to be unique, so derive the name from
+    it.
+    """
+    safe = re.sub(r"[^A-Za-z0-9_]", "_", module_id or "")
+    if not safe or not (safe[0].isalpha() or safe[0] == "_"):
+        safe = "_" + safe
+    return f"snes_program_module_register_{safe}"
+
+
