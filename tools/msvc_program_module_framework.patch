index bbf0f968..23e25b99 100644
--- a/runner/src/program_module.h
+++ b/runner/src/program_module.h
@@ -73,13 +73,34 @@ void snes_program_module_select(const SnesProgramModule *module);
 const SnesProgramModule *snes_program_module_active(void);
 
 /* Constructor plumbing shared with mod_runtime.h's SNES_MOD_CONSTRUCTOR; kept
- * separate so generated code depends on nothing but this header. */
+ * separate so generated code depends on nothing but this header.
+ *
+ * MSVC needs the extra `/include:` for Release. The pointer in `.CRT$XCU` is
+ * only read by the CRT's own `_initterm` walk, which the C compiler cannot
+ * see, so an internal-linkage (`static`) initialiser is dead code: Release
+ * builds with whole-program optimisation and `/OPT:REF`, and the entry was
+ * dropped. The registry was then empty, and a universal executable refused
+ * every ROM because no module was ever registered (Debug kept the entry,
+ * which is why it booted). External linkage plus `/include:` gives the linker
+ * the reference it needs -- the same fix `interp_bridge.c` uses for its dump
+ * hook. The symbol name must therefore be unique per linked tree;
+ * `v2_emit` derives it from the module id. */
 #if defined(_MSC_VER)
 #pragma section(".CRT$XCU", read)
+/* 32-bit MSVC decorates a C symbol with a leading underscore; x64 does not.
+ * interp_bridge.c spells both out for the same reason. */
+#if defined(_M_IX86)
+#define SNES_PROGRAM_MODULE_CONSTRUCTOR_INCLUDE(name)                        \
+    __pragma(comment(linker, "/include:_" #name "_constructor"))
+#else
+#define SNES_PROGRAM_MODULE_CONSTRUCTOR_INCLUDE(name)                        \
+    __pragma(comment(linker, "/include:" #name "_constructor"))
+#endif
 #define SNES_PROGRAM_MODULE_CONSTRUCTOR(name)                                \
     static void __cdecl name(void);                                          \
     __declspec(allocate(".CRT$XCU"))                                         \
-    static void (__cdecl *name##_constructor)(void) = name;                  \
+    void (__cdecl *name##_constructor)(void) = name;                         \
+    SNES_PROGRAM_MODULE_CONSTRUCTOR_INCLUDE(name)                            \
     static void __cdecl name(void)
 #elif defined(__GNUC__) || defined(__clang__)
 #define SNES_PROGRAM_MODULE_CONSTRUCTOR(name)                                \
