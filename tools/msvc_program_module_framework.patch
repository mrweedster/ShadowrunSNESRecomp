+def test_descriptor_constructor_name_is_unique_per_module():
+    # MSVC's macro gives the .CRT$XCU entry external linkage (a static one is
+    # dropped in Release), so every linked tree needs its own symbol name.
+    digest = "ab" * 32
+    names = set()
+    for module_id, prefix in (("main", None), ("shadowrun-de", "shadowrun_de"),
+                              ("shadowrun-sv", "shadowrun_sv")):
+        src = emit_module_descriptor(module_id, prefix, 0x100000, digest)
+        match = re.search(r"SNES_PROGRAM_MODULE_CONSTRUCTOR\((\w+)\)", src)
+        assert match, src
+        names.add(match.group(1))
+    assert names == {
+        "snes_program_module_register_main",
+        "snes_program_module_register_shadowrun_de",
+        "snes_program_module_register_shadowrun_sv",
+    }
+    assert module_constructor_ident("smas.smb1") == \
+        "snes_program_module_register_smas_smb1"
+
+
 def test_identity_rules():
     validate_module_identity("smw", None)
     validate_module_identity("smas.smb1", "smas")
