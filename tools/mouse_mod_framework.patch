+/* The player's cursor setting (g_cursor, flipped by the fullscreen key and
+ * restored after the launcher) and a title's request to draw its own
+ * pointer are separate: the OS pointer is visible only when both agree. */
+static bool g_game_pointer;
+
+static void HostApplyCursorVisibility(void) {
+  const bool visible = g_cursor && !g_game_pointer;
+  if (snesrecomp_sdl_cursor_visible() == visible) return;
+
+  /* SNESRECOMP_MOUSE_DEBUG=1: one line per change, beside the mapping lines
+   * from snesrecomp_desktop_mouse_state(). */
+  static int debug = -1;
+  if (debug < 0) {
+    const char *v = HostGetenv("MOUSE_DEBUG");
+    debug = (v && *v && *v != '0') ? 1 : 0;
+  }
+  if (debug)
+    fprintf(stderr,
+            "[mouse] OS pointer %s (title pointer %d, host cursor %d)\n",
+            visible ? "shown" : "hidden", (int)g_game_pointer, (int)g_cursor);
+
+  snesrecomp_sdl_show_cursor(visible);
+}
+
+void snesrecomp_desktop_set_game_pointer(int active) {
+  /* Re-apply even when active is unchanged: the launcher, a focus change or
+   * the fullscreen key may have shown the pointer behind our back between
+   * frames, and the comparison in HostApplyCursorVisibility() makes this
+   * idempotent. */
+  g_game_pointer = active != 0;
+  HostApplyCursorVisibility();
+}
