+int snesrecomp_desktop_mouse_state(int *x, int *y, unsigned *buttons) {
+  if (!g_window) return 0;
+
+  int win_w = 0, win_h = 0, win_x = 0, win_y = 0;
+  SDL_GetWindowSize(g_window, &win_w, &win_h);
+  SDL_GetWindowPosition(g_window, &win_x, &win_y);
+  if (win_w <= 0 || win_h <= 0) return 0;
+
+  /* Ask the platform, not SDL's cached focus-relative cursor: the app can be
+   * active while SDL has not yet latched an enter event (activation and a
+   * pointer that has not moved since the window opened is the common case),
+   * and then SDL_GetMouseState() answers from the wrong window. The global
+   * query is immediate and the window position is where SDL puts the client
+   * area, so the subtraction gives the same point coordinates as the cached
+   * one once motion has been seen. */
+  float gx = 0.0f, gy = 0.0f;
+  Uint32 held = 0;
+#if SNESRECOMP_SDL3
+  held = SDL_GetGlobalMouseState(&gx, &gy);
+#else
+  {
+    int ix = 0, iy = 0;
+    held = SDL_GetGlobalMouseState(&ix, &iy);
+    gx = (float)ix;
+    gy = (float)iy;
+  }
+#endif
+  /* SDL's event-driven cache is the authoritative button view (the global
+   * query is the platform's async state; a synthetic or remapped event can
+   * reach one and not the other). OR the two so a real click is seen
+   * whichever path it took. */
+  const Uint32 cached_buttons = SDL_GetMouseState(NULL, NULL);
+  held |= cached_buttons;
+
+  /* Window-local pointer, for the one platform where the global answer is not
+   * a desktop coordinate. Wayland does not tell a client where its window is,
+   * so SDL_GetWindowPosition() answers 0,0 and Wayland's
+   * SDL_GetGlobalMouseState() is already window-relative while the pointer is
+   * over the surface -- and answers 0,0, not the pointer, as soon as it is
+   * not. SDL's cached position is the right source there; it is only trusted
+   * while the window has mouse focus, because after a leave it still holds the
+   * last point seen inside the surface. Windows, X11 and macOS have real
+   * desktop coordinates and keep the global subtraction, which also works
+   * before the first motion event has reached SDL's cache. */
+  const char *video_driver = SDL_GetCurrentVideoDriver();
+  const bool wayland = video_driver && strcmp(video_driver, "wayland") == 0;
+
+  float cached_x = 0.0f, cached_y = 0.0f;
+#if SNESRECOMP_SDL3
+  SDL_GetMouseState(&cached_x, &cached_y);
+#else
+  {
+    int ix = 0, iy = 0;
+    SDL_GetMouseState(&ix, &iy);
+    cached_x = (float)ix;
+    cached_y = (float)iy;
+  }
+#endif
+
+  const int mx = wayland ? (int)cached_x : (int)gx - win_x;
+  const int my = wayland ? (int)cached_y : (int)gy - win_y;
+
+  const SDL_WindowFlags flags = SDL_GetWindowFlags(g_window);
+  const int input_focus = (flags & SDL_WINDOW_INPUT_FOCUS) != 0;
+  const int mouse_focus = (flags & SDL_WINDOW_MOUSE_FOCUS) != 0;
+  const int inside_window = mx >= 0 && my >= 0 && mx < win_w && my < win_h;
+
+  /* Mouse coordinates are in window points, the presenters work in drawable
+   * pixels: on a Retina display they differ by the backing scale. */
+  int drawable_w = 0, drawable_h = 0;
+  snesrecomp_sdl_get_drawable_size(g_window, &drawable_w, &drawable_h);
+  if (drawable_w <= 0 || drawable_h <= 0) return 0;
+  const int px = (int)((int64_t)mx * drawable_w / win_w);
+  const int py = (int)((int64_t)my * drawable_h / win_h);
+
+  const int frame_w = snesrecomp_desktop_frame_width();
+  const int frame_h = snesrecomp_desktop_frame_height();
+  SnesDisplayViewport viewport;
+  SnesDisplayAspect_ComputeViewport(
+      frame_w, frame_h, drawable_w, drawable_h,
+      SnesDisplayAspect_Clamp(g_config.display_aspect),
+      g_config.ignore_aspect_ratio, false, &viewport);
+  if (g_game->compute_viewport)
+    g_game->compute_viewport(frame_w, frame_h, drawable_w, drawable_h, &viewport);
+
+  /* SNESRECOMP_MOUSE_DEBUG=1: one line a second with everything the mapping
+   * used, so a title's pointer that lands in the wrong place can be read off
+   * instead of guessed at (Retina scale, letterbox, window scale). Logged
+   * before the gates so a pointer that never reaches the guest also shows
+   * up. */
+  static int debug = -1;
+  static uint32 last_debug_log;
+  if (debug < 0) {
+    const char *v = HostGetenv("MOUSE_DEBUG");
+    debug = (v && *v && *v != '0') ? 1 : 0;
+  }
+  if (debug) {
+    const uint32 now = SDL_GetTicks();
+    if (now - last_debug_log >= 1000) {
+      last_debug_log = now;
+      fprintf(stderr,
+              "[mouse] window %d,%d %dx%d drawable %dx%d viewport %d,%d %dx%d "
+              "driver %s global %.0f,%.0f point %d,%d input=%d mouse=%d "
+              "held=0x%x cached=0x%x%s\n",
+              win_x, win_y, win_w, win_h, drawable_w, drawable_h,
+              viewport.x, viewport.y, viewport.width, viewport.height,
+              video_driver ? video_driver : "?", (double)gx, (double)gy,
+              mx, my, input_focus, mouse_focus,
+              (unsigned)held, (unsigned)cached_buttons,
+              inside_window ? "" : " (outside window)");
+    }
+  }
+
+  if (!input_focus || !inside_window) return 0;
+  /* Wayland's cached point is only live while the surface has the pointer. */
+  if (wayland && !mouse_focus) return 0;
+  if (viewport.width <= 0 || viewport.height <= 0) return 0;
+  if (px < viewport.x || py < viewport.y ||
+      px >= viewport.x + viewport.width || py >= viewport.y + viewport.height)
+    return 0;
+
+  if (x) *x = (int)((int64_t)(px - viewport.x) * frame_w / viewport.width);
+  if (y) *y = (int)((int64_t)(py - viewport.y) * frame_h / viewport.height);
+  if (buttons) *buttons = (unsigned)held;
+  return 1;
+}
