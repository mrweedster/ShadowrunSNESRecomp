+/* The mouse as this frame's SDL sees it, in SNES frame pixels.
+ *
+ * x/y are 0..frame_width-1 / 0..frame_height-1 after undoing the window's
+ * letterbox and the drawable-size scale, so a title can put an in-game
+ * pointer under the OS pointer without knowing which renderer or scale is
+ * in use. buttons is SDL's button mask (SDL_BUTTON_LMASK / MMASK / RMASK).
+ *
+ * Returns 1 only while this window has input focus and the pointer is
+ * inside the presented image; 0 leaves x/y/buttons untouched. A title that
+ * reads this every frame therefore leaves its guest alone while the pointer
+ * is over another application or the letterbox. */
+int snesrecomp_desktop_mouse_state(int *x, int *y, unsigned *buttons);
+
+/* Tell the host that the title is drawing its own pointer under the mouse.
+ *
+ * While active is nonzero the OS pointer is hidden whenever this window has
+ * input focus, so a guest hand cursor and the system arrow do not sit on top
+ * of each other. Passing 0 gives the pointer back. A title calls this every
+ * frame with the result of snesrecomp_desktop_mouse_state(), so leaving the
+ * window, switching applications or the fullscreen key still behaves the
+ * way the player expects: the pointer reappears outside the image and the
+ * host's own cursor setting is never overwritten, only layered over. */
+void snesrecomp_desktop_set_game_pointer(int active);
 /* Selected PPU renderer, shared by hotkeys and diagnostic playback. Setting
  * this also updates the live config; it does not write the user's file. */
 int snesrecomp_desktop_new_renderer(void);
