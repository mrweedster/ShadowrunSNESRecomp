+static inline bool snesrecomp_sdl_cursor_visible(void) {
+#if SNESRECOMP_SDL3
+  return SDL_CursorVisible();
+#else
+  return SDL_ShowCursor(SDL_QUERY) == SDL_ENABLE;
+#endif
+}
+
+/* Window events that end a title's pointer ownership. The SDL3 event names
+ * and the SDL2 window-event subtypes do not compare the same way, so the
+ * host asks here instead of spelling both out at each call site. */
+static inline bool snesrecomp_sdl_event_window_left(const SDL_Event *event) {
+#if SNESRECOMP_SDL3
+  return event->type == SDL_EVENT_WINDOW_MOUSE_LEAVE;
+#else
+  return event->type == SDL_WINDOWEVENT &&
+         event->window.event == SDL_WINDOWEVENT_LEAVE;
+#endif
+}
+
+static inline bool snesrecomp_sdl_event_window_focus_lost(
+    const SDL_Event *event) {
+#if SNESRECOMP_SDL3
+  return event->type == SDL_EVENT_WINDOW_FOCUS_LOST;
+#else
+  return event->type == SDL_WINDOWEVENT &&
+         event->window.event == SDL_WINDOWEVENT_FOCUS_LOST;
+#endif
+}
