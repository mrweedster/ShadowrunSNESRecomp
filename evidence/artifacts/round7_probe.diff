   }
-  if (reg == 0x2137)
-    snes_sync_master_clock(g_snes, g_cpu.master_cycles);
+  if (reg == 0x2137) {
+    /* Round-7 experiment: the interpreter commits its per-transfer master
+     * charge only after the opcode returns, so at this read it still sits at
+     * the opcode's start, while AOT has already charged this instruction's
+     * fetches and the paced data transfer.  Optionally advance the beam to the
+     * in-flight time so both tiers latch the same counter phase.  Default off
+     * (= pinned behaviour); SNESRECOMP_LATCHLOG frames it. */
+    extern uint64_t interp_bridge_pending_master(void);
+    extern unsigned long g_r7_c530_inv;
+    uint64_t _pending = interp_bridge_pending_master();
+    static int _sync_pending = -1;
+    if (_sync_pending < 0) {
+      const char *e = getenv("SNESRECOMP_LATCH_SYNC");
+      _sync_pending = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    static int _ll = -1, _llo = 0, _lhi = 0x7fffffff;
+    if (_ll < 0) {
+      const char *e = getenv("SNESRECOMP_LATCHLOG");
+      _ll = (e && e[0] && e[0] != '0') ? 1 : 0;
+      e = getenv("SNESRECOMP_LATCHLOG_FRAMES");
+      if (e && e[0] && sscanf(e, "%d-%d", &_llo, &_lhi) != 2) _llo = 0, _lhi = 0x7fffffff;
+    }
+    uint64_t _sync = g_cpu.master_cycles + (_sync_pending ? _pending : 0);
+    snes_sync_master_clock(g_snes, _sync);
+    if (_ll) {
+      extern int snes_frame_counter;
+      extern const char *g_last_recomp_func;
+      extern uint32_t g_interp_wlog_pc24;
+      if (snes_frame_counter >= _llo && snes_frame_counter <= _lhi)
+        fprintf(stderr,
+                "[latch] f=%d inv=%lu tier=%s func=%s pc=%06X master=%llu pending=%llu "
+                "eff=%llu sync=%llu h=%u v=%u\n",
+                snes_frame_counter, g_r7_c530_inv, _pending ? "interp" : "aot",
+                g_last_recomp_func ? g_last_recomp_func : "-",
+                (unsigned)g_interp_wlog_pc24,
+                (unsigned long long)g_cpu.master_cycles,
+                (unsigned long long)_pending,
+                (unsigned long long)(g_cpu.master_cycles + _pending),
+                (unsigned long long)_sync,
+                (unsigned)(g_snes->hPos / 4), (unsigned)g_snes->vPos);
+    }
+  }
   if (reg >= 0x3000 && reg < 0x3300 && g_snes->cart->type == CART_SUPERFX) {
     cart_sync_coprocessors(g_snes->cart, g_cpu.master_cycles);
     return cart_read(g_snes->cart, 0, reg);
