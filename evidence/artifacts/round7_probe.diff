diff --git a/runner/src/common_cpu_infra.c b/runner/src/common_cpu_infra.c
index c9314d9a..2716f64a 100644
--- a/runner/src/common_cpu_infra.c
+++ b/runner/src/common_cpu_infra.c
@@ -930,6 +930,23 @@ void snes_refresh_state_set(uint64_t phase, uint64_t charged_upto) {
 }
 
 // Called at loop headers in generated code — detect infinite loops
+unsigned long g_r7_c530_inv;
+
+/* Round-7 phase tap: exact AOT entries into one body, with the cumulative
+ * master clock.  Called from the trace-off cpu_trace_func_entry inline, so it
+ * sees only real function entries (WatchdogCheck also fires on interior
+ * blocks of the same function).  Gated by SNESRECOMP_PHASETAP. */
+void r7_tap_func_entry(CpuState *cpu, uint32_t pc24, const char *name) {
+  static int tap = -1;
+  if (tap < 0) { const char *e = getenv("SNESRECOMP_PHASETAP");
+                 tap = (e && e[0] && e[0] != '0') ? 1 : 0; }
+  if (!tap || pc24 != 0x80C530u) return;
+  g_r7_c530_inv++;
+  fprintf(stderr, "[tap] f=%d inv=%lu tier=aot func=%s master=%llu\n",
+          snes_frame_counter, g_r7_c530_inv, name ? name : "-",
+          (unsigned long long)cpu->master_cycles);
+}
+
 void WatchdogCheck(void) {
   snes_refresh_charge();
 #ifdef SNES_COSIM
