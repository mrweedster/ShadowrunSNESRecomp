+/* Round-7 phase tap: exact AOT entries into one body, with the cumulative
+ * master clock.  Called from the trace-off cpu_trace_func_entry inline, so it
+ * sees only real function entries (WatchdogCheck also fires on interior
+ * blocks of the same function).  Gated by SNESRECOMP_PHASETAP. */
+/* Round-8 anchor set: SNESRECOMP_ANCHORTAP="a,b,c" (hex pc24).  Matched at
+ * compiled-function entry and at interpreted opcode start, so a guest PC the
+ * two legs reach on different tiers is still a comparable sample point. */
+static int r8_anchor_init = 0;
+static int r8_anchor_n = 0;
+static uint32_t r8_anchor_pcs[8];
+int r8_anchor_match(uint32_t pc24) {
+  if (!r8_anchor_init) {
+    const char *e = getenv("SNESRECOMP_ANCHORTAP");
+    r8_anchor_init = 1;
+    /* Off only for empty or exactly "0"; a pc24 may legitimately start with
+     * a zero digit (e.g. 00C0E2). */
+    if (e && e[0] && !(e[0] == '0' && e[1] == '\0')) {
+      const char *q = e;
+      while (*q && r8_anchor_n < 8) {
+        char *end = NULL;
+        unsigned long v = strtoul(q, &end, 16);
+        if (end == q) break;
+        r8_anchor_pcs[r8_anchor_n++] = (uint32_t)v;
+        q = end;
+        if (*q == ',') q++; else break;
+      }
+    }
+  }
+  for (int i = 0; i < r8_anchor_n; i++)
+    if (pc24 == r8_anchor_pcs[i]) return 1;
+  return 0;
+}
+
+void r7_tap_func_entry(CpuState *cpu, uint32_t pc24, const char *name) {
+  /* Round-8 entry timeline: every compiled-function entry in a frame window,
+   * in execution order, with the cumulative master clock.  Both legs compile
+   * the same 283-body pair set, so a shared pc is a comparable anchor. */
+  static int et = -1, elo = 0, ehi = 0;
+  if (et < 0) {
+    const char *e = getenv("SNESRECOMP_ENTRYTAP");
+    et = (e && e[0] && e[0] != '0') ? 1 : 0;
+    if (et && e && e[0] && e[0] != '0') sscanf(e, "%d-%d", &elo, &ehi);
+  }
+  if (et && snes_frame_counter >= elo && snes_frame_counter <= ehi)
+    fprintf(stderr, "[entry] f=%d pc=%06X master=%llu trunk=%llu\n",
+            snes_frame_counter, (unsigned)pc24,
+            (unsigned long long)cpu->master_cycles,
+            (unsigned long long)cpu->cycles);
+  static int tap = -1;
+  if (tap < 0) { const char *e = getenv("SNESRECOMP_PHASETAP");
+                 tap = (e && e[0] && e[0] != '0') ? 1 : 0; }
+  if (r8_anchor_match(pc24))
+    fprintf(stderr, "[anchor] f=%d pc=%06X tier=aot master=%llu\n",
+            snes_frame_counter, (unsigned)pc24,
+            (unsigned long long)cpu->master_cycles);
+  if (!tap || pc24 != 0x80C530u) return;
+  g_r7_c530_inv++;
+  fprintf(stderr, "[tap] f=%d inv=%lu tier=aot func=%s master=%llu\n",
+          snes_frame_counter, g_r7_c530_inv, name ? name : "-",
+          (unsigned long long)cpu->master_cycles);
+}
+
+/* Round-9 block tap: every AOT basic-block entry (and, via r9_tap_interp,
+ * every interpreted opcode start) inside a frame window and pc range, with
+ * the cumulative clocks.  Both legs compile the bodies on this path, so a
+ * shared block pc is a directly comparable sample.  Gated by
+ * SNESRECOMP_BLOCKTAP=frame_lo-frame_hi and SNESRECOMP_BLOCKTAP_PC=lo-hi
+ * (hex pc24, inclusive). */
+static int r9_bt = -1, r9_flo = 0, r9_fhi = 0;
+static unsigned r9_plo = 0, r9_phi = 0xFFFFFFu;
+
+static void r9_bt_init(void) {
+  if (r9_bt >= 0) return;
+  const char *e = getenv("SNESRECOMP_BLOCKTAP");
+  r9_bt = (e && e[0] && !(e[0] == '0' && e[1] == '\0')) ? 1 : 0;
+  if (r9_bt && e) sscanf(e, "%d-%d", &r9_flo, &r9_fhi);
+  const char *p = getenv("SNESRECOMP_BLOCKTAP_PC");
+  if (p && p[0]) sscanf(p, "%x-%x", &r9_plo, &r9_phi);
+}
+
+static int r9_bt_wanted(uint32_t pc24) {
+  r9_bt_init();
+  if (!r9_bt) return 0;
+  if (snes_frame_counter < r9_flo || snes_frame_counter > r9_fhi) return 0;
+  return pc24 >= r9_plo && pc24 <= r9_phi;
+}
+
+void r9_tap_block(CpuState *cpu, uint32_t pc24) {
+  if (!r9_bt_wanted(pc24)) return;
+  fprintf(stderr, "[block] f=%d pc=%06X tier=aot master=%llu trunk=%llu\n",
+          snes_frame_counter, (unsigned)pc24,
+          (unsigned long long)cpu->master_cycles,
+          (unsigned long long)cpu->cycles);
+}
+
+void r9_tap_interp(CpuState *cpu, uint32_t pc24) {
+  if (!r9_bt_wanted(pc24)) return;
+  fprintf(stderr, "[block] f=%d pc=%06X tier=interp master=%llu trunk=%llu\n",
+          snes_frame_counter, (unsigned)pc24,
+          (unsigned long long)cpu->master_cycles,
+          (unsigned long long)cpu->cycles);
+}
+
